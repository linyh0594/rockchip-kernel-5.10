# SPDX-License-Identifier: GPL-2.0
# Apply after rockchip_linux_defconfig and rk3588_linux.config.

# Power, RTC and board peripherals
CONFIG_MFD_RK806_SPI=y
CONFIG_REGULATOR_RK806=y
CONFIG_REGULATOR_RK860X=y
CONFIG_RTC_DRV_HYM8563=y
CONFIG_KEYBOARD_ADC=y
CONFIG_LEDS_GPIO=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_SENSORS_PWM_FAN=y

# ES8316 analog audio, HDMI and DisplayPort audio
CONFIG_SND_SOC_ROCKCHIP_MULTICODECS=y
CONFIG_SND_SOC_ES8316=y
CONFIG_SND_SOC_ROCKCHIP_HDMI=y

# RTL8111 PCIe Ethernet (supported by the existing vendor driver)
CONFIG_R8168=y
# CONFIG_R8169 is not set

# AIC8800 uses the original SDIO wiring and MMC power sequence.
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_RFKILL_RK=y
# CONFIG_BCMDHD is not set
# CONFIG_AP6XXX is not set
CONFIG_CFG80211=y
CONFIG_AIC_WLAN_SUPPORT=m
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y

# User-accessible SPI controller
CONFIG_SPI_ROCKCHIP=y
CONFIG_SPI_SPIDEV=y


CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
